# Datos: nunca al repositorio. Los datos de origen se identifican por su hash en registry/.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/sealed/

# Evidencias originales con datos privados: solo en el PC de SQX (el repositorio es público).
# En h0/evidencias/ va la copia redactada; el registro guarda el hash de las dos.
h0/evidencias_privadas/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# Secretos y configuración local
.env
.env.*
.claude/settings.local.json

# Sistema
.DS_Store
Thumbs.db
